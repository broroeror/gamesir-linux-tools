# Grant the logged-in desktop user access to the GameSir Cyclone 2 vendor HID
# interface, so the app runs WITHOUT sudo. Scoped to GameSir's USB vendor id
# (0x3537) only - no other device is affected.
#
# Install:
#   sudo cp 70-gamesir.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# Unplug and replug after installing so every identity receives its ACL.
#
# TAG+="uaccess" hands an ACL to whoever is logged in at the local seat (the
# modern, group-free way). IMPORTANT: the filename MUST sort before
# 73-seat-late.rules, which is the rule that actually applies the uaccess ACL -
# udev runs rules in lexical order, so a 99-* name sets the tag too late and the
# ACL is silently never granted. Hence the 70- prefix; do not renumber it >=73.
#
# On a headless/remote box with no local seat, uaccess won't apply; use a group
# instead, e.g.:  SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3537", MODE="0660", GROUP="input"
# and add yourself to that group (then re-login).
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3537", TAG+="uaccess"

# Also grant the controller's input event nodes, so the app can EVIOCGRAB the
# emulated mouse/keyboard for the "Suppress emulated mouse/keyboard" toggle
# (fixes the post-reconnect mouse-mode). The gamepad/joystick node is grabbed
# only while you enable the toggle; nothing here changes normal input.
SUBSYSTEM=="input", ATTRS{idVendor}=="3537", TAG+="uaccess"

# G7 Pro configuration uses interface 0 through native libusb rather than
# hidraw, so it needs a rule on the USB device itself. One rule per WRITABLE
# identity -- Shadow Ember 109b (wired) / 109c (dongle) and the Amazon edition
# 10ba -- plus 100a, the HID identity Deadband transitions through before
# opening a configuration session.
#
# This list mirrors protocol.CONFIG_PIDS and smoke_test.py fails if it drifts.
# An edition missing from it reads as "raw USB access: PERMISSION DENIED" in the
# diagnostics even though everything else is correct.
#
# Editions Deadband recognises but does NOT write to (White Trimode 1003,
# Zenless Zone Zero 105e) are deliberately absent: they have never accepted a
# config write, so granting access we never use buys nothing. If someone
# confirms a write round-trip on one, it moves into CONFIG_PIDS and gains a line
# here at the same time.
SUBSYSTEM=="usb", ATTR{idVendor}=="3537", ATTR{idProduct}=="109b", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="3537", ATTR{idProduct}=="109c", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="3537", ATTR{idProduct}=="10ba", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="3537", ATTR{idProduct}=="100a", TAG+="uaccess"
